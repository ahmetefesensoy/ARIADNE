<?xml version="1.0"?>
<!-- SCENARIO T3: bounded wait/replan only. No Spin, BackUp or costmap erasure.
     On exhaustion the action fails; RequestHelp/mission escalation is deferred. -->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3" name="NavigateWithBoundedWait">
      <PipelineSequence name="ReplanAndFollow">
        <RateController hz="1.0">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"
                             error_code_id="{compute_path_error_code}"/>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"
                    error_code_id="{follow_path_error_code}"/>
      </PipelineSequence>
      <ReactiveFallback name="WaitOrAcceptNewGoal">
        <GoalUpdated/>
        <Wait wait_duration="2.0"/>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
