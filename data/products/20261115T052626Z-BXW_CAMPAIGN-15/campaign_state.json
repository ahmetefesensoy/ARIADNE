{"schema": "redline.campaign.v1", "status": "SCENARIO", "revision": 24, "task_index": 12, "task_count": 12, "task": {"id": "debrief", "title": "12 / Dönüş ve debrief", "instruction": "Komutada E ile EVA kaydını kapat. Numuneler, ürünler ve karar gerekçeleri kalır.", "kind": "debrief", "actor": "EV1", "target_id": "COMMAND", "xy": [285.1, -456.0], "phase": 4}, "tasks": [{"id": "briefing", "title": "01 / Çıkış brifingi", "instruction": "Komuta panosunda soruyu, giysiyi ve dönüş payını incele; E ile keşif hazırlığına geç.", "kind": "briefing", "actor": "EV1", "target_id": "COMMAND", "xy": [285.1, -456.0], "phase": 0}, {"id": "scout", "title": "02 / Öncü drone keşfi", "instruction": "Komutadan E ile keşfi başlat. Gözlem kanıtı gelmeden saha kararı açılmaz.", "kind": "scout", "actor": "scout_1", "target_id": "CORRIDOR", "xy": [285.1, -456.0], "phase": 1}, {"id": "route", "title": "03 / Saha kararı", "instruction": "M panosunda 1: sırt, 2: çukur rotasını seç. Gözlemi ve belirsizliği birlikte değerlendir.", "kind": "decision", "actor": "EV1", "target_id": "COMMAND", "xy": [285.1, -456.0], "phase": 0}, {"id": "collect", "title": "04 / Yüzey numunesini al", "instruction": "Hedefe git; E ile seçme, aleti indirme, toplama ve kaba alma işlemini başlat.", "kind": "collect", "actor": "EV1", "target_id": "BXW_RIDGE_A", "xy": [306.0, -454.0], "phase": 2}, {"id": "xrf", "title": "05 / El tipi temas ölçümü", "instruction": "Aynı hedefte E ile ölçümü başlat. Hata çubuklu bileşim ürünü tamamlandığında kaydedilir.", "kind": "xrf", "actor": "EV1", "target_id": "BXW_RIDGE_A", "xy": [306.0, -454.0], "phase": 3}, {"id": "weather", "title": "06 / Çevre istasyonunu yerleştir", "instruction": "Hedefte E ile doz istasyonunu yerleştir; istasyon kimliği ve konumu kayda girer.", "kind": "weather", "actor": "EV1", "target_id": "BXW_RIDGE_A", "xy": [306.0, -454.0], "phase": 3}, {"id": "rover_libs", "title": "07 / Rover hedef incelemesi", "instruction": "E ile roverı hedefe gönder. Nav2 varışı doğrular, ardından LIBS ölçümü yürür.", "kind": "libs", "actor": "rover_1", "target_id": "BXW_RIDGE_A", "xy": [306.0, -454.0], "phase": 3}, {"id": "rover_dan", "title": "08 / Yeraltı hidrojen taraması", "instruction": "E ile DAN taramasını başlat. WEH ve belirsizlik ürünü veri panosuna gelir.", "kind": "dan", "actor": "rover_1", "target_id": "BXW_RIDGE_A", "xy": [306.0, -454.0], "phase": 3}, {"id": "drill", "title": "09 / Sondaj ve arıza yönetimi", "instruction": "E ile sondajı başlat. Derinlik/kuvvet/tork ve varsa arıza ürün sonucuyla gösterilir.", "kind": "drill", "actor": "rover_1", "target_id": "BXW_RIDGE_A", "xy": [306.0, -454.0], "phase": 3}, {"id": "cache", "title": "10 / Laboratuvara numune teslimi", "instruction": "Bilim hazırlık odasına dön. E ile kabı teslim et; numune kökeni ve analiz yeri ayrı tutulur.", "kind": "cache", "actor": "EV1", "target_id": "LAB", "xy": [285.1, -468.0], "phase": 4}, {"id": "assessment", "title": "11 / Veriye göre karar", "instruction": "Komuta ekranında ürünleri ve hata çubuklarını incele. 1: örüntü desteği, 2: ek ölçüm gerekiyor.", "kind": "assessment", "actor": "EV1", "target_id": "COMMAND", "xy": [285.1, -456.0], "phase": 3}, {"id": "debrief", "title": "12 / Dönüş ve debrief", "instruction": "Komutada E ile EVA kaydını kapat. Numuneler, ürünler ve karar gerekçeleri kalır.", "kind": "debrief", "actor": "EV1", "target_id": "COMMAND", "xy": [285.1, -456.0], "phase": 4}], "completed": ["briefing", "scout", "route", "collect", "xrf", "weather", "rover_libs", "rover_dan", "drill", "cache", "assessment", "debrief"], "state": "complete", "operation_id": "integration-11-22", "operation_phase": "QUEUED", "progress": 1.0, "message": "EVA kaydı tamamlandı.", "branch": "ridge", "product_ids": ["sim-sample-20261115T052626Z-BXW_CAMPAIGN-15-820df794c7a5f018", "sim-apxs-20261115T052626Z-BXW_CAMPAIGN-15-d463a5b9b59eb29e", "sim-dosimeter-20261115T052626Z-BXW_CAMPAIGN-15-134fbfd5b4848c2c", "sim-libs-20261115T052626Z-BXW_CAMPAIGN-15-fe7a804b6da3a83d",