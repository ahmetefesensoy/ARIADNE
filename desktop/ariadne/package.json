{
  "name": "ariadne-desktop",
  "version": "0.1.0",
  "description": "Ariadne Windows presentation preview",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "record": "electron . --record-tour",
    "package": "electron-packager . Ariadne --platform=win32 --arch=x64 --out=../../outputs/ariadne --icon=assets/ariadne.ico --app-version=0.1.0 --overwrite --ignore=^/captures --ignore=^/node_modules/@electron"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "@electron/packager": "20.3.0"
  }
}
